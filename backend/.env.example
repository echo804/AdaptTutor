# AdaptTutor 配置示例（复制为 .env 使用；.env 不入库）
# 对齐 docs/00-环境搭建.md 4.2 配置项清单

# --- 数据库（本地用 5433 避开上级项目占用的 5432）---
DATABASE_URL=postgresql+asyncpg://adapt:adapt_dev_pw@localhost:5433/adapttutor

# --- LLM 系统级 key（04 v0.4：仅开发/测试/内部用途，不作为用户兜底）---
LITELLM_API_KEYS=sk-xxx
MODEL_ROUTING={"diagnostic":"deepseek/deepseek-chat","tutor":"deepseek/deepseek-chat","generate":"qwen/qwen-turbo"}

# --- 密钥与加密（生产必须更换）---
# API_KEY_ENC_KEY 用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
API_KEY_ENC_KEY=change-me-fernert-key
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_EXPIRE_MINUTES=720

# --- 注册 ---
INVITE_ONLY=true

# --- 领域包 ---
DOMAIN_PACK_PATH=./domain_packs
ACTIVE_DOMAIN_PACK=junior_math_eq_ineq

# --- 评估 ---
PURITY_THRESHOLD=0.9

# --- 日志 / 备份 ---
LOG_LEVEL=INFO
BACKUP_DIR=D:\AdaptTutorBackup

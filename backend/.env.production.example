# AdaptTutor 生产环境配置模板
# 用法：python scripts/gen_prod_secrets.py  → 生成 backend/.env.production（自动填入强密钥）
# 之后手动填写：LITELLM_API_KEYS / MODEL_ROUTING（可选系统级 LLM key）

# --- 数据库（compose 内网直连，密码由 compose 环境变量 POSTGRES_PASSWORD 控制）---
DATABASE_URL=postgresql+asyncpg://adapt:adapt_prod_pw@postgres:5432/adapttutor

# --- LLM 系统级 key（可选；用户自配 key 不依赖此项）---
# LITELLM_API_KEYS=
# MODEL_ROUTING=

# --- 密钥与加密（由 gen_prod_secrets.py 生成，请勿提交真实值）---
API_KEY_ENC_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# --- 注册 ---
INVITE_ONLY=true

# --- 领域包（compose 挂载卷）---
DOMAIN_PACK_PATH=/app/domain_packs
ACTIVE_DOMAIN_PACK=junior_math_eq_ineq

# --- 生产 CORS 额外放行源（逗号分隔，如 http://1.2.3.4:3000；deploy.sh 会自动写入）---
CORS_ORIGINS_EXTRA=

# --- 评估 ---
PURITY_THRESHOLD=0.9

# --- 日志 / 备份 ---
LOG_LEVEL=INFO
BACKUP_DIR=/app/backups

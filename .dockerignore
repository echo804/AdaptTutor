# 根构建上下文 .dockerignore（backend/frontend 镜像共用）
# 排除开发/密钥/大目录，domain_packs 必须保留（进后端镜像作内置包）

# VCS / IDE
.git
.gitignore
.idea
.vscode

# 密钥与本地环境
backend/.env
backend/.env.production
backend/.env.local
backend/.env.*.local

# Python
backend/.venv
backend/venv
backend/__pycache__
backend/.pytest_cache
backend/*.egg-info
backend/tests

# Node
frontend/node_modules
frontend/.next
frontend/npm-debug.log*

# 工具产物
.playwright-mcp
scripts
docs
*.log
